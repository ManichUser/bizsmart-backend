// Ce fichier décrit la structure de la base de données. Prisma lit ce
// fichier et génère automatiquement le code TypeScript pour lire/écrire
// dans PostgreSQL — on n'écrit jamais de SQL à la main pour les
// opérations courantes.
//
// Depuis Prisma 7 : l'URL de connexion ne vit plus ici, elle est
// définie dans prisma.config.ts (à la racine du projet).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 👤 UTILISATEURS
// ============================================

enum Role {
  USER  // Client — peut acheter dans plusieurs boutiques (compte global)
  ADMIN // Commerçant — propriétaire d'UNE boutique
  SUPER // Administrateur de la plateforme BizSmart (Niveau 1)
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un compte avec role=ADMIN possède exactement une boutique. On ne
  // promeut jamais un utilisateur en ADMIN "à la main" : c'est la
  // création d'une boutique (voir StoresModule, prochain bloc) qui fait
  // cette promotion, plus tard.
  ownedStore    Store?
  refreshTokens RefreshToken[]

  @@map("users")
}

// ============================================
// 🔑 REFRESH TOKENS (rotation)
// ============================================

model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // On ne stocke JAMAIS le token en clair (même principe qu'un mot de
  // passe) : seulement son empreinte SHA-256. Si la base fuite, les
  // tokens ne sont pas directement réutilisables.
  tokenHash String @unique

  expiresAt DateTime
  // Rempli dès que ce token a été utilisé (rotation) ou révoqué
  // manuellement (déconnexion). Un token avec revokedAt != null ne peut
  // plus jamais servir.
  revokedAt DateTime?

  // Pointe vers le token qui l'a remplacé lors de la rotation — forme
  // une chaîne qui permet de détecter une réutilisation frauduleuse.
  replacedById String?  @unique
  replacedBy   RefreshToken?  @relation("TokenChain", fields: [replacedById], references: [id])
  replaces     RefreshToken?  @relation("TokenChain")

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================
// 🏪 BOUTIQUES (tenants)
// ============================================

enum StoreStatus {
  ACTIVE
  SUSPENDED
}

model Store {
  id      String @id @default(uuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  name        String
  // Identifiant technique utilisé dans le sous-domaine :
  // {slug}.bizsmart.africa — décision validée avec le porteur du projet.
  slug        String @unique
  description String?
  logo        String?

  email   String?
  phone   String?
  address String?
  city    String?

  // Géolocalisation exacte (optionnelle) — pour permettre au client de
  // localiser la boutique depuis sa position.
  latitude  Float?
  longitude Float?

  status StoreStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories Category[]

  @@map("stores")
}

// ============================================
// 🗂️ CATÉGORIES
// ============================================

model Category {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unicité PAR boutique : deux boutiques différentes peuvent chacune
  // avoir une catégorie "Gâteaux" sans se marcher dessus.
  @@unique([storeId, slug])
  @@unique([storeId, name])
  @@index([storeId])
  @@map("categories")
}
