NODE_ENV=development
PORT=3001

# Domaine racine pour la détection de sous-domaine (voir TenantMiddleware).
# En local : lvh.me pointe automatiquement vers 127.0.0.1, aucune
# configuration réseau nécessaire. En production : bizsmart.africa.
ROOT_DOMAIN=lvh.me

# Ton PostgreSQL local ou hébergé (Neon, Supabase, Railway...)
# connect_timeout=15 : laisse 15s à Neon pour "réveiller" sa base après
# une période d'inactivité (plan gratuit = mise en veille au bout de
# 5 min sans requête). Sans ça, la première requête après une pause
# peut timeout avant que Neon ait fini de redémarrer.
DATABASE_URL=postgresql://user:password@localhost:5432/bizsmart?connect_timeout=15

# --- Authentification (JWT) ---
JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_EXPIRATION=10m
JWT_REFRESH_EXPIRATION_DAYS=7
