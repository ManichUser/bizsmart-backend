NODE_ENV=development
PORT=3001

# Domaine racine pour la détection de sous-domaine (voir TenantMiddleware).
# En local : lvh.me pointe automatiquement vers 127.0.0.1, aucune
# configuration réseau nécessaire. En production : bizsmart.africa.
ROOT_DOMAIN=lvh.me

# Ton PostgreSQL local ou hébergé (Neon, Supabase, Railway...)
DATABASE_URL=postgresql://user:password@localhost:5432/bizsmart

# --- Authentification (JWT) ---
JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_EXPIRATION=10m
JWT_REFRESH_EXPIRATION_DAYS=7
